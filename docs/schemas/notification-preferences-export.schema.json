{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notification Preferences Export (KAN-100)",
  "type": "object",
  "required": ["customerId", "email", "sms", "push_notification", "exportedAt"],
  "additionalProperties": false,
  "properties": {
    "customerId": { "type": "string", "minLength": 1 },
    "email": { "type": "boolean" },
    "sms": { "type": "boolean" },
    "push_notification": { "type": "boolean" },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
    }
  }
}
